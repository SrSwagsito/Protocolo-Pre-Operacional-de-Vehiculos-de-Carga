      optionC: "Mugre de barrido y Pl\xE1stico"
      optionD: Colillas de cigarrillo
      correctAnswer: 0
      correctTrueFalse: 0
  - sprite: {fileID: -60215412, guid: bd4d475814724724ca161c41b0ebd824, type: 3}
    questions:
    - questionType: 1
      question: Las servilletas usadas son residuos ordinarios.
      optionA: Azul
      optionB: Verde
      optionC: Gris
      optionD: Negro
      correctAnswer: 0
      correctTrueFalse: 1
    - questionType: 0
