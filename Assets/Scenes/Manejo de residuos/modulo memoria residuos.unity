  - sprite: {fileID: -121802169, guid: bd4d475814724724ca161c41b0ebd824, type: 3}
    questions:
    - questionType: 0
      question: "\xBFEn qu\xE9 contenedores puedes depositar residuos org\xE1nicos?"
      optionA: Verde y Beige
