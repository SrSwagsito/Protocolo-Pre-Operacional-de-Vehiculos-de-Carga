  - sprite: {fileID: -273967041, guid: bd4d475814724724ca161c41b0ebd824, type: 3}
    questions:
    - questionType: 1
      question: Separar correctamente los residuos facilita su aprovechamiento.
      optionA: Verde y Beige
      optionB: Verde y blanco
      optionC: Beige y Azul
      optionD: Negro y Rojo
      correctAnswer: 0
      correctTrueFalse: 1
    - questionType: 0
      question: "\xBFQu\xE9 se logra con una correcta separaci\xF3n?"
      optionA: Mayor mezcla de residuos
      optionB: Aprovechamiento de materiales
      optionC: "M\xE1s residuos en los rellenos"
      optionD: Menor reciclaje
      correctAnswer: 1
      correctTrueFalse: 1
    - questionType: 0
      question: "\xBFPor qu\xE9 es importante separar correctamente los residuos
        dentro del Aeropuerto El Dorado?"
      optionA: Porque asi los residuos ocupan menos espacio
      optionB: Porque la separacion de residuos evitan llenar mas rapido las canecas
      optionC: "Porque la correcta separaci\xF3n de los residuos permite su aprovechamiento
        mediante reciclaje y otros procesos de sostenibilidad, apoyando la econom\xEDa
        circular y reduciendo la cantidad de desechos que llegan a rellenos sanitarios."
      optionD: Porque los residuos se mezclan nuevamente
      correctAnswer: 2
      correctTrueFalse: 0
